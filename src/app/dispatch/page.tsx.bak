import { prisma } from "@/lib/prisma";
import { PageHeader, Avatar, StatusChip, TypeChip } from "@/components/ui";
import { timeOf } from "@/lib/utils";

export default async function Dispatch() {
  const [techs, jobs] = await Promise.all([
    prisma.technician.findMany(),
    prisma.job.findMany({ include: { customer: true }, orderBy: { scheduledAt: "asc" } }),
  ]);
  const hours = Array.from({ length: 12 }, (_, i) => 7 + i);
  const unassigned = jobs.filter((j) => !j.technicianId);

  return (
    <div>
      <PageHeader title="Giao việc" subtitle="Timeline theo kỹ thuật viên · 24/4/2026" />
      <div className="p-6 flex gap-4">
        <div className="w-64 card p-3 shrink-0">
          <div className="font-semibold mb-2">Việc chưa giao ({unassigned.length})</div>
          <div className="space-y-2">
            {unassigned.map((j) => (
              <div key={j.id} className="p-3 bg-warn-50 rounded-lg border border-warn-500/30 cursor-grab">
                <div className="flex items-center justify-between mb-1">
                  <span className="font-mono text-[10px] text-ink-500">{j.id}</span>
                  <TypeChip type={j.type} />
                </div>
                <div className="text-sm font-medium">{j.title}</div>
                <div className="text-xs text-ink-500 mt-0.5">{j.customer.name}</div>
                <div className="text-xs text-ink-500">{timeOf(j.scheduledAt)} · {j.duration}</div>
              </div>
            ))}
            {unassigned.length === 0 && <div className="text-xs text-ink-500 py-3">Đã giao hết</div>}
          </div>
        </div>

        <div className="flex-1 card overflow-auto">
          <div className="grid" style={{ gridTemplateColumns: "180px repeat(12, minmax(80px, 1fr))" }}>
            <div className="sticky left-0 bg-white border-b border-r border-ink-150 px-3 py-2 text-xs font-semibold z-10">Kỹ thuật viên</div>
            {hours.map((h) => (
              <div key={h} className="border-b border-ink-150 px-2 py-2 text-xs text-ink-500 text-center">{h}:00</div>
            ))}

            {techs.map((t) => {
              const techJobs = jobs.filter((j) => j.technicianId === t.id);
              return (
                <>
                  <div key={`t-${t.id}`} className="sticky left-0 bg-white border-b border-r border-ink-150 px-3 py-4 z-10 flex items-center gap-2">
                    <Avatar initials={t.initials} color={t.color} size={32} />
                    <div className="min-w-0">
                      <div className="text-sm font-semibold truncate">{t.name.split(" ").slice(-2).join(" ")}</div>
                      <div className="text-[10px] text-ink-500">{t.skill}</div>
                    </div>
                  </div>
                  <div key={`row-${t.id}`} className="border-b border-ink-150 relative" style={{ gridColumn: `span 12` }}>
                    <div className="grid h-16" style={{ gridTemplateColumns: "repeat(12, 1fr)" }}>
                      {hours.map((h) => <div key={h} className="border-r border-ink-100" />)}
                    </div>
                    {techJobs.map((j) => {
                      const [hh, mm] = timeOf(j.scheduledAt).split(":").map(Number);
                      const start = (hh - 7) + mm / 60;
                      const durMatch = j.duration.match(/(\d+)h\s*(\d+)?/);
                      const dur = durMatch ? parseInt(durMatch[1]) + (parseInt(durMatch[2] || "0") / 60) : 1;
                      return (
                        <div key={j.id}
                          className="absolute top-2 bottom-2 rounded-lg px-2 py-1.5 text-xs text-white overflow-hidden"
                          style={{ left: `calc(${(start / 12) * 100}% + 2px)`, width: `calc(${(dur / 12) * 100}% - 4px)`, background: t.color }}>
                          <div className="font-mono text-[9px] opacity-80">{j.id}</div>
                          <div className="font-semibold truncate">{j.title}</div>
                        </div>
                      );
                    })}
                  </div>
                </>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  );
}
